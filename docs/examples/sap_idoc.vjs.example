# connector: sap_idoc — SAP IDoc inbound as a stream (registered RFC server).
#
# The `vejas-sap-rfc` binary (native Rust over libsapnwrfc — ADR-0014) registers
# at the SAP gateway as a server program and streams every inbound call: an
# IDOC_INBOUND_ASYNCHRONOUS carries the IDoc control (EDI_DC40) + data (EDI_DD40)
# records, emitted as ONE JSON line, which the exec-stream-source driver
# publishes to SUBJECT. Isolated exec process (ADR-0011): the FFI/dlopen lives in
# that binary, never in the runtime — a native crash restarts only the connector.
#
# Deploy beside SAP, where libsapnwrfc.so ships with the kernel
# (/usr/sap/<SID>/SYS/exe/...). SAP side: an RFC destination (SM59, "Registered
# Server Program") whose Program ID = SAP_PROGRAM_ID, a port (WE21) over that
# destination, and a partner profile (WE20) routing the message type to it.
# Credentials come from secret() (ADR-0008) — never a literal; ENV hands them to
# the child's environment (never argv: /proc/<pid>/environ is owner-only).
driver "exec-stream-source"
SUBJECT = "vx.sap.idoc"
CMD = "/opt/vejas/vejas-sap-rfc idoc-server"
ENV = {LD_LIBRARY_PATH: "/usr/sap/NPL/D00/exe", SAP_ASHOST: "localhost", SAP_SYSNR: "00", SAP_CLIENT: "001", SAP_USER: "DEVELOPER", SAP_PASSWD: secret("sap/npl/passwd"), SAP_LANG: "EN", SAP_PROGRAM_ID: "VEJAS_IDOC", SAP_GWHOST: "localhost", SAP_GWSERV: "sapgw00"}
RESTART_SECS = 5
