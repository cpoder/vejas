# connector: amqp_sink — deliver bus messages into a RabbitMQ queue (ADR-0026).
# A first-class standalone binary (connectors/amqp), pure Rust, sync, no
# tokio, no OpenSSL: TLS is rustls over amiquip's mio loop. At-least-once:
# basic.publish on a confirm-enabled channel — the bus message is acked only
# after RabbitMQ's publisher confirm. A crash between confirm and ack can
# re-publish: carry an idempotency key in the payload for downstream dedup.
# Subjects in: vx.amqp.orders.out · out: (none) · secrets: the URL carries
# the credentials — take it from your deployment's secret machinery, never
# a literal in this file.
# Build once: cargo build --release --manifest-path connectors/amqp/Cargo.toml
# Run under your process supervisor.

VEJAS_AMQP_URL="${AMQP_URL:?take amqp(s)://user:password@host:port from your secret store}"
VEJAS_AMQP_MODE=sink
VEJAS_AMQP_QUEUE=orders.out
VEJAS_AMQP_ROUTING_KEY=orders.out
VEJAS_AMQP_SUBJECT=vx.amqp.orders.out
VEJAS_AMQP_DURABLE=vejas_amqp_orders_out
NATS_URL=127.0.0.1:4222

# TLS (amqps://): pin your CA and the server name rustls verifies against
#VEJAS_AMQP_TLS_CA=/etc/vejas/rabbitmq-ca.pem
#VEJAS_AMQP_TLS_SERVER_NAME=rabbitmq.internal
