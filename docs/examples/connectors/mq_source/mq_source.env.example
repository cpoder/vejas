# connector: mq_source — consume an IBM MQ queue onto the bus (ADR-0023).
# A first-class standalone binary (connectors/mq), NOT a runtime driver: the
# transactional order MQGET-under-syncpoint -> bus publish (await JetStream
# pub-ack) -> MQCMIT needs its own MQ and NATS clients in one process. A crash
# before MQCMIT re-delivers from MQ: at-least-once, no loss — the queue
# manager is the durable cursor (no offset KV; contrast Kafka/ADR-0022).
# Subjects in: (none) · out: vx.mq.orders.in · secrets: none inline — client
# auth rides the MQ client's own machinery (CCDT + TLS keystore, channel
# auth), never a value in this file.
# Build once: cargo build --release --manifest-path connectors/mq/Cargo.toml
# (builds WITHOUT any MQ installed; only the RUN needs libmqic_r.so — the
# IBM MQ redistributable client). Run under your process supervisor.

# ── standard IBM MQ client env (read by libmqic, not by us) ──────────────
MQSERVER="DEV.APP.SVRCONN/TCP/mq.example.com(1414)"
# TLS / HA channels: use a CCDT instead of MQSERVER:
#   MQCCDTURL="file:///etc/mq/ccdt.json"

# ── the connector ────────────────────────────────────────────────────────
VEJAS_MQ_MODE=source
VEJAS_MQ_QMGR=QM1
VEJAS_MQ_QUEUE=DEV.QUEUE.1
VEJAS_MQ_SUBJECT=vx.mq.orders.in
NATS_URL=127.0.0.1:4222

# MQGET wait per poll round (seconds; the loop is a long-get, not a spin)
VEJAS_MQ_WAIT_SECS=3
# Singleton by default BECAUSE order (ADR-0020/0023): instances contend on a
# JetStream KV lease; exactly one gets. Opt into competing consumers — MQGET
# is destructive so competing is duplicate-safe — when throughput matters
# more than global order:
#VEJAS_MQ_COMPETING=1
