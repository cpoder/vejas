# connector: mq_sink — deliver bus messages into an IBM MQ queue (ADR-0023).
# A first-class standalone binary (connectors/mq), NOT a runtime driver: the
# transactional order bus fetch -> MQPUT-under-syncpoint -> MQCMIT -> ack the
# bus message needs its own MQ and NATS clients in one process. A failed
# MQCMIT does NOT ack the bus, so the message redelivers: at-least-once.
# Subjects in: vx.mq.orders.out · out: (none) · secrets: none inline — client
# auth rides the MQ client's own machinery (CCDT + TLS keystore, channel
# auth), never a value in this file.
# Build once: cargo build --release --manifest-path connectors/mq/Cargo.toml
# (builds WITHOUT any MQ installed; only the RUN needs libmqic_r.so — the
# IBM MQ redistributable client). Run under your process supervisor.

# ── standard IBM MQ client env (read by libmqic, not by us) ──────────────
MQSERVER="DEV.APP.SVRCONN/TCP/mq.example.com(1414)"
# TLS / HA channels: use a CCDT instead of MQSERVER:
#   MQCCDTURL="file:///etc/mq/ccdt.json"

# ── the connector ────────────────────────────────────────────────────────
VEJAS_MQ_MODE=sink
VEJAS_MQ_QMGR=QM1
VEJAS_MQ_QUEUE=DEV.QUEUE.OUT
VEJAS_MQ_SUBJECT=vx.mq.orders.out
NATS_URL=127.0.0.1:4222

# durable pull-consumer name on the bus (resume point across restarts)
VEJAS_MQ_DURABLE=vejas_mq_orders_out
# at-least-once means a redelivered bus message can be MQPUT twice; name a
# JSON field here and its value rides MQMD CorrelId so the consumer on the
# MQ side can dedup:
#VEJAS_MQ_DEDUP_FIELD=order_id
