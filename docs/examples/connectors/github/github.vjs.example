# connector: github — Comprehensive GitHub API integration
#
# Platform connector for GitHub. Supports multiple operations:
# - Issues (create, update, list, comment)
# - Pull Requests (create, update, list, review, merge)
# - Repositories (create, update, list, webhooks)
# - Events (webhook processing via polling)
# - Commits (list, get, create)
# - Releases (create, update, list)
#
# Uses oauth-poll driver for event streaming. Individual operations use http-out
# in flows that consume from vx.github.events or make direct API calls.
#
# Subjects:
#   OUT: vx.github.events (all GitHub repository events)
#
# Secrets:
#   github/token - GitHub personal access token or OAuth token
#
# Rate limits: 5000 req/hour for authenticated requests
# Pagination: Link header-based with page/per_page parameters
#
# Authentication: Bearer token in Authorization header
# API Version: 2022-11-28 (specified in X-GitHub-Api-Version header)

driver "oauth-poll"

# Event polling configuration
SUBJECT = "vx.github.events"
BASE_URL = "https://api.github.com"
POLL_ENDPOINT = "/repos/{owner}/{repo}/events"
POLL_INTERVAL = 300
CURSOR_PATH = "[0].id"
CURSOR_PARAM = "since"

# Authentication
HEADERS = {
  Authorization: "Bearer " + secret("github/token"),
  "X-GitHub-Api-Version": "2022-11-28",
  Accept: "application/vnd.github+json"
}

# Pagination
LIMIT_PARAM = "per_page"
LIMIT_VALUE = 100

# Response handling - GitHub events are returned as array
DATA_PATH = "."
