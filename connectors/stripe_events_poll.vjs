# connector: stripe_events_poll — Poll Stripe events API via exec-stream-source
# Polls Stripe events API and emits events to vx.stripe.events
# Auth: secret("stripe/api_key") = sk_live_... or sk_test_...

driver "exec-stream-source"
SUBJECT = "vx.stripe.events"
CMD = "./connectors/stripe/target/release/vejas-stripe events"
ENV = {
    "STRIPE_API_KEY": secret("stripe/api_key"),
    "STRIPE_INTERVAL_SECS": "60"
}
