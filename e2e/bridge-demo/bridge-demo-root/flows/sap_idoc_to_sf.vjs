# flow: sap_idoc_to_sf — a SAP IDoc's account segments -> a Salesforce bulk insert.
#
# SAP pushes an inbound IDoc to our registered RFC server (sap_idoc_in), which
# streams it onto vx.sap.idoc. Each IDOC_DATA_REC_40 segment carries one account
# name in SDATA; we build the batch and hand it to the Salesforce bulk-insert
# sink (sf_ingest) in one message.
source "vx.sap.idoc"

# The label stamped on accounts that arrive from SAP. A business literal — the
# expert edits it in the panel (and can shadow-replay the change first).
DEFAULT_INDUSTRY = "From SAP IDoc"

if func == "IDOC_INBOUND_ASYNCHRONOUS":
    accounts = []
    for seg in tables["IDOC_DATA_REC_40"]["rows"]:
        accounts = accounts + [{Name: seg["SDATA"], Industry: DEFAULT_INDUSTRY}]
    end
    emit "vx.sf.ingest", {rows: accounts}
end
